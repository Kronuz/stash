# stash: many producers insert lock-free; one consumer drains in key order.
# Render: d2 docs/stash.d2 docs/stash.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: down

producers: Producers {
  shape: rectangle
  style.multiple: true
  label: "producers\nadd(ctx, key, value)"
}

consumer: Consumer {
  label: "one consumer\nwalk · peep · clean"
}

wheel: "StashSlots levels: slot = key / Div % Mod" {
  grid-columns: 4
  grid-gap: 40
  l1: "18 s × 4800"
  l2: "500 ms × 36"
  l3: "50 ms × 10"
  l4: "1 ms × 50"
}

leaf: StashValues leaf {
  shape: queue
  label: "StashValues\nappend-only leaf"
}

producers -> wheel: "lock-free CAS"
wheel -> leaf
consumer -> wheel: "drains in key order" {style.stroke-dash: 3}
